# --- Supabase ---
# Z dashboardu Supabase → Project Settings → API.
# Anon (publishable) key — bezpieczny do exposure w przeglądarce, RLS pilnuje dostępu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — TYLKO server-side (cron, admin actions).
# NIGDY nie commituj.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron ---
# Dowolny losowy string. Vercel Cron wysyła go w nagłówku Authorization: Bearer <CRON_SECRET>.
# Wygeneruj np. `openssl rand -hex 32`.
CRON_SECRET=

# --- App ---
# Pełny URL aplikacji (używany do password reset link redirect).
# Lokalnie: http://localhost:3000 | preview/prod: URL z Vercela albo własna domena.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
